            ]
          ],
          "require_correlation": 1
        },
        {
          "pairs": [
            [
              0,
              1
            ],
            [
              1,
              1
            ],
            [
              2,
              1
            ]
          ],
          "require_correlation": 1
        }
      ],
      "extra_valid": [
        {
          "pairs": [
            [
              0,
              1
            ],
            [
              1,
              1
            ],
            [
              2,
              1
            ]
          ],
          "require_correlation": 0
        }
      ],
      "transfer": "比较回归斜率为0与皮尔逊相关系数无定义的区别。"
    },
    {
      "op": "triangle_included_angle",
      "topic": "两边夹角正弦决定面积",
      "reason": "坐标叉积严格给出3-4-5直角三角形面积6；换用非夹角的正弦3/5会算错面积。",
      "valid": {
        "P": [
          0,
          0
        ],
        "Q": [
          3,
          0
        ],
        "R": [
          0,
          4
        ],
        "sine": [
