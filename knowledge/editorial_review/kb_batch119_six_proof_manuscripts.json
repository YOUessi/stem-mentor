    "boundary": "区间内部不可导时不能直接用结论；需特别留意a<b。",
    "candidate_id": "hs-semantic-pilot-119-a06",
    "claim": "存在c∈(a,b)，使f'(c)=[f(b)-f(a)]/(b-a)。",
    "counterexample": "f(x)=|x|定义于[-1,1]，割线斜率0，但两侧可导处导数分别-1和1，缺少可导性导致无符合条件的c。",
    "course_track": "ELECTIVE_A",
    "hypotheses": [
      "a<b",
      "f在[a,b]连续",
      "f在(a,b)可导"
    ],
    "machine_general_proof_certified": false,
    "proof_review_id": "kb119-proof-a06",
    "proof_steps": [
      {
        "claim": "构造去除割线的函数",
        "justification": "设m=[f(b)-f(a)]/(b-a)，g(x)=f(x)-m(x-a)。"
      },
      {
        "claim": "核对Rolle前提",
        "justification": "g在[a,b]连续、在(a,b)可导，而且g(a)=f(a)，g(b)=f(b)-m(b-a)=f(a)。"
      },
      {
        "claim": "应用Rolle定理",
        "justification": "由Rolle（由极值定理与内点极值处导数为零推得），存在c∈(a,b)使g'(c)=0。"
      },
      {
        "claim": "还原斜率",
        "justification": "g'(c)=f'(c)-m，因而f'(c)=m。"
      }
    ],
