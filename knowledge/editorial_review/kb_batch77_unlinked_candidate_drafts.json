      "assumptions": [
        "论域和谓词P在前后两句完全相同",
        "采用经典二值逻辑"
      ],
      "common_wrong_method": "只把x²>0改成x²≤0却保留∀，产生比真实否定更强的命题。",
      "counterexample": "错误否定‘所有实数平方都严格正’为‘所有实数平方均非正’；x=1即可否定后者。",
      "curriculum_track_hint": "COMPULSORY",
      "definition": "在非空论域D中，¬(∀x∈D,P(x))当且仅当∃x∈D,¬P(x)；¬(∃x∈D,P(x))当且仅当∀x∈D,¬P(x)。",
      "far_transfer": "用软件断言的‘所有输入通过’和存在失败样本的关系作类比。",
      "finite_case": {
        "exists_not": true,
        "forall": false,
        "truths": [
          true,
          false,
          true
        ],
        "type": "quantifier_negation"
      },
      "graduated_hints": [
        "找出最外层是∀还是∃。",
        "换成另一种量词但保持D。",
        "只在内部P(x)上取逻辑否定，给出见证或证明。"
      ],
      "id": "KB77-M01",
      "independent_challenge_solution_reveal": false,
      "invalid_boundary": "空论域也有相应的标准逻辑语义，但本教学例按非空实数域；不把逆否命题与量词否定混同。",
      "knowledge_kind": "THEOREM",
      "local_source_mathematical_relation": "RELATED_DISTINCT",
      "mathematical_certification": "NOT_FORMALLY_CERTIFIED",
      "mathematical_validity": "量词交换是逻辑等价规律，不依靠抽样若干数值来证明全称。",
      "near_transfer": "否定∀n∈N,n≥5并给出一个违例。",
      "official_atom_count": null,
      "prerequisite_ids_confirmed": false,
      "prerequisite_topics": [
        "命题与逻辑联结词",
        "整数量词与不等式"
      ],
      "reasoning_steps": [
        [
          "否定全称",
          "∀x P(x)失败意味着至少存在一个x使P(x)不成立。"
        ],
        [
          "否定存在",
          "∃x P(x)失败意味着没有任何x满足P；故每一个x都满足¬P。"
        ],
        [
          "保留论域",
          "对实数论域的命题不能在取反时悄悄改成整数论域。"
        ],
        [
          "给出反例",
          "∀x∈R,x²>0为假：x=0；其否定∃x∈R,x²≤0为真。"
        ]
      ],
      "source_editorial_subspan_id": "KB75-P016-S03",
      "source_license": "ORIGINAL_PROJECT_AUTHORED",
      "source_subspan_sha256": "ad188e8982a4291db7aabcdd84f9929db9d0c41f647325e5738021f02a2f133a",
      "statement": "否定量词须交换∀和∃并否定其内部谓词，不可只改不等式符号。",
      "student_publishable": false,
      "symbols": [
        "D:非空论域",
        "∀:对所有",
        "∃:存在",
        "¬:逻辑否定"
      ],
      "teacher_proof_review": "NOT_COMPLETED",
      "teacher_review": "REVIEW_PENDING",
      "teacher_signature": null,
      "teacher_solution_visibility": "TEACHER_ONLY",
      "title": "量词命题的否定、论域及反例构造",
      "worked_examples": [
        [
          "在全体实数论域内，否定∀x∈R,x²>0。",
          "∃x∈R,x²≤0；可取x=0成立。"
        ],
        [
          "在整数论域内，否定命题∃n∈Z,n²<0。",
          "∀n∈Z,n²≥0；整数平方均非负，因而该否定为真。"
        ]
      ]
    },
    {
      "assumptions": [
        "使用标准复平面坐标与通常复数乘法",
        "反射轴是虚轴即x=0"
      ],
      "common_wrong_method": "把复数乘i一律解释为关于虚轴对称，混淆旋转与反射。",
      "counterexample": "z=1时关于虚轴反射为-1，乘i为i，结果不同。",
      "curriculum_track_hint": "COMPULSORY",
      "definition": "复数z=x+yi对应点(x,y)，关于虚轴反射得到(-x,y)，对应w=-共轭(z)；乘i得到(-y,x)，一般是逆时针90°旋转而非反射。",
      "far_transfer": "用图像处理中水平翻转和图像旋转区别两种变换。",
      "finite_case": {
        "reflected": [
          -2,
